{
  "hosting": {
    "public": "static-site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "videos/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/images/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
